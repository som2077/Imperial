# ==============================================================================
# SAAS STARTER KIT - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Fill in your actual credentials from each respective service dashboard.
# NEVER commit `.env.local` to GitHub or public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION BASE URL
# ------------------------------------------------------------------------------
# In local development: http://localhost:3000
# In production: https://your-domain.com (without trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 2. SUPABASE (Authentication & Client SDK)
# ------------------------------------------------------------------------------
# Where to get these:
# 1. Go to https://supabase.com/dashboard
# 2. Select your Project -> Click on "Project Settings" (gear icon) -> "API"
# 3. Copy "Project URL" and "anon public" API key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"


# ------------------------------------------------------------------------------
# 3. DATABASE CONNECTION (Drizzle ORM & PostgreSQL)
# ------------------------------------------------------------------------------
# Where to get this:
# 1. In Supabase Dashboard -> "Project Settings" -> "Database"
# 2. Scroll to "Connection Pooling" section:
#    - Select "Mode: Transaction" (Port 6543) - Recommended for Serverless/Next.js
# 3. Replace [YOUR-PASSWORD] with your actual Supabase database password.
DATABASE_URL="postgres://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"


# ------------------------------------------------------------------------------
# 4. LEMON SQUEEZY (Payments, Subscriptions & Merchant of Record)
# ------------------------------------------------------------------------------
# Where to get these:
# 1. Sign up / Log in to https://app.lemonsqueezy.com
# 2. API Key: Settings -> "API Keys" -> Click "+ New API Key"
LEMON_SQUEEZY_API_KEY="your-lemon-squeezy-api-key"

# 3. Store ID: Settings -> "Stores" (You will see your numeric Store ID, e.g. 123456)
LEMON_SQUEEZY_STORE_ID="123456"

# 4. Webhook Signing Secret:
#    - Settings -> "Webhooks" -> Click "+ New Webhook"
#    - URL: https://your-domain.com/api/webhooks/lemonsqueezy
#      (For local testing, use ngrok or webhook tunnel: https://xxxx.ngrok-free.app/api/webhooks/lemonsqueezy)
#    - Select Events: Subscription Created, Updated, Cancelled, Resumed, Expired
#    - Enter a secret passphrase below:
LEMON_SQUEEZY_WEBHOOK_SECRET="your-custom-webhook-secret-passphrase"

# 5. Product Variant IDs:
#    - Go to "Products" -> Click on your Subscription product -> Variants
#    - Click on the Variant -> Copy Variant ID from the URL or table
LEMON_SQUEEZY_PRO_VARIANT_ID="987654"
LEMON_SQUEEZY_PRO_ANNUAL_VARIANT_ID="987655"
LEMON_SQUEEZY_ENTERPRISE_VARIANT_ID="987656"
LEMON_SQUEEZY_ENTERPRISE_ANNUAL_VARIANT_ID="987657"


# ------------------------------------------------------------------------------
# 5. RESEND (Transactional Emails)
# ------------------------------------------------------------------------------
# Where to get these:
# 1. Go to https://resend.com -> Log in
# 2. Go to "API Keys" -> Click "Create API Key"
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# 3. The email address emails are sent from:
#    - For development/testing: "onboarding@resend.dev" (works without custom domain)
#    - For production: "support@yourdomain.com" (requires verifying your domain in Resend)
EMAIL_FROM="onboarding@resend.dev"


# ------------------------------------------------------------------------------
# 6. POSTHOG (Product Analytics, Session Replays & User Tracking)
# ------------------------------------------------------------------------------
# Where to get these:
# 1. Go to https://us.posthog.com or https://eu.posthog.com
# 2. Project Settings -> "Project API Key"
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_project_api_key"

# Host URL:
# - US Cloud: "https://us.i.posthog.com"
# - EU Cloud: "https://eu.i.posthog.com"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"


# ------------------------------------------------------------------------------
# 7. GOOGLE ANALYTICS (GA4 - Marketing Traffic & Attribution)
# ------------------------------------------------------------------------------
# Where to get this:
# 1. Go to https://analytics.google.com
# 2. Admin -> Data Streams -> Web -> Copy "Measurement ID" (starts with G-)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"


# ------------------------------------------------------------------------------
# 8. OPENAI (Vercel AI SDK Integration)
# ------------------------------------------------------------------------------
# Where to get this:
# 1. Go to https://platform.openai.com/api-keys
# 2. Click "Create new secret key"
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"


# ------------------------------------------------------------------------------
# 9. CLOUDFLARE TURNSTILE (Bot & Fraud Protection)
# ------------------------------------------------------------------------------
# Where to get these:
# 1. Go to https://dash.cloudflare.com -> Turnstile
# 2. Add Site -> Select "Managed" or "Invisible" mode
# Test Site Key (always passes): 1x00000000000000000000AA
# Test Secret Key (always passes): 1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET_KEY=""


# ------------------------------------------------------------------------------
# 10. CLOUDINARY (Media Storage, Transformations & CDN)
# ------------------------------------------------------------------------------
# Where to get these:
# 1. Go to https://cloudinary.com/console
# 2. Copy "Cloud name", "API Key", and "API Secret" from Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# ------------------------------------------------------------------------------
# 11. CRON JOBS & AUTOMATION PACK
# ------------------------------------------------------------------------------
# A secure token used by Vercel Cron, GitHub Actions, or external schedulers
# Example curl: curl -X POST https://your-domain.com/api/cron/webhook-retries -H "Authorization: Bearer [CRON_SECRET]"
CRON_SECRET="your-high-entropy-cron-secret-token"
